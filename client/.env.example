VITE_API_BASE_URL=http://localhost:5000/api
# When true, the app serves API responses from the MSW mock layer
# (src/mocks) instead of hitting a real backend — see src/mocks/README.md.
VITE_ENABLE_MOCKS=true

# Public site origin — used to build absolute canonical/OG/Twitter URLs
VITE_SITE_URL=https://www.zerivon.in

# Optional — error tracking. Leave blank to run with no client-side error reporting.
VITE_SENTRY_DSN=
