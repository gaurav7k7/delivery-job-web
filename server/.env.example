# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/zerivon

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_SECRET=replace-with-another-random-64-char-hex-string

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Caching (optional — leave blank to run with no server-side response cache)
REDIS_URL=

# Public site origin — used to build absolute URLs in sitemap.xml/robots.txt
SITE_URL=https://www.zerivon.in

# Optional — error tracking. Leave blank to run with no error reporting (logs to console only).
SENTRY_DSN=

# Optional — password-reset emails. Leave blank to log the reset link to the
# server console instead of sending a real email (fine for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zerivon <no-reply@zerivon.in>"

# Optional — only read by `npm run seed`. Leave blank to auto-generate a
# random password for the first admin user (printed once at seed time).
SEED_ADMIN_NAME=Zerivon Admin
SEED_ADMIN_EMAIL=admin@zerivon.in
SEED_ADMIN_PASSWORD=
