{
  "name": "zerivon-server",
  "version": "1.0.0",
  "private": true,
  "description": "Zerivon backend — REST API (MVC + Repository pattern)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "npm run verify:models",
    "lint": "eslint .",
    "verify:models": "node --check src/models/index.js",
    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "sitemap": "^9.0.1",
    "slugify": "^1.6.9",
    "streamifier": "^0.1.1",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  }
}
